# Skip postinstall scripts in workspace members. In particular, this prevents
# web-components' `patch-package` postinstall from failing — that patch-package
# config patches packages installed by web-components' inner yarn workspaces
# (dev/, test/), which the outer npm workspace does not recurse into. The
# patches only affect upstream `dev:build` (gh-pages playground) and
# `test-runner-visual-regression`; neither runs from this workspace.
ignore-scripts=true
